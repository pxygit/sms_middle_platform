# SunnySMS deployment environment
COMPOSE_PROJECT_NAME=sunnysms
SUNNYSMS_HTTP_PORT=8088
APP_TIMEZONE=Asia/Shanghai
PUID=1000
PGID=1000

# Image build versions
GO_VERSION=1.25.0
NODE_VERSION=24-alpine
VITE_API_BASE_URL=/api/v1

# PostgreSQL. Data is stored in deploy/data/postgres on the host.
POSTGRES_DB=sunnysms
POSTGRES_USER=sunnysms
POSTGRES_PASSWORD=change-me-postgres-password

# Backend runtime
APP_ENV=production
HTTP_ADDR=:8080
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
DATA_ENCRYPTION_KEY=change-me-data-key-at-least-32-chars
JWT_EXPIRE_HOURS=24
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-admin-password

# Supplier API keys can also be managed in the admin provider page after startup.
SMSPOOL_API_KEY=
SMSPOOL_BASE_URL=https://api.smspool.net
SMSPOOL_TIMEOUT_SECONDS=15

FIREFOX_API_KEY=
FIREFOX_BASE_URL=http://www.firefox.fun
FIREFOX_TIMEOUT_SECONDS=15

HEROSMS_API_KEY=
HEROSMS_BASE_URL=https://hero-sms.com
HEROSMS_TIMEOUT_SECONDS=15

SMSBOWER_API_KEY=
SMSBOWER_BASE_URL=https://smsbower.page
SMSBOWER_TIMEOUT_SECONDS=15

FIVESIM_API_KEY=
FIVESIM_BASE_URL=https://5sim.net
FIVESIM_TIMEOUT_SECONDS=15

LUBANSMS_API_KEY=
LUBANSMS_BASE_URL=https://lubansms.com
LUBANSMS_TIMEOUT_SECONDS=15

SMS68_API_KEY=
SMS68_BASE_URL=https://api.68sms.com
SMS68_TIMEOUT_SECONDS=15
SMS68_METADATA_TOKEN=

SMS62US_API_KEY=
SMS62US_BASE_URL=https://api.62-us.com
SMS62US_TIMEOUT_SECONDS=15

ORDER_POLL_INTERVAL_SECONDS=8
ORDER_TIMEOUT_SECONDS=1200
CARD_EXPORT_DIR=/app/storage/card_exports